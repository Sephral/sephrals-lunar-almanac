  "compatibility": {
    "minimum": 14,
    "verified": "14.369"
  },
  "authors": [
    {
      "name": "Sephral",
      "url": "https://github.com/Sephral"
    }
  ],
  "url": "https://github.com/Sephral/sephrals-lunar-almanac.git",
  "relationships": {
    "requires": [
      {
        "id": "ember",
        "type": "module",
        "compatibility": {
          "minimum": "0.6.3",
          "verified": "0.6.3"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/sla.mjs"
  ],
  "styles": [
    "styles/sla.css"
  ],
  "languages": [
    {
      "lang": "en",
