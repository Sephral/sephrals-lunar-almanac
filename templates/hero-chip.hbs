<button type="button" class="sla-hero {{#if blessed}}blessed{{/if}}" data-actor-id="{{id}}"
        {{#if canOpen}}data-action="openActor"{{else}}disabled{{/if}} data-tooltip-html="{{tooltip}}">
  <img src="{{img}}" alt="" loading="lazy">
  <span class="sla-hero-name">{{name}}</span>
  {{#if rank includeZero=true}}<span class="sla-rank">{{localize "SLA.Hero.RankShort" rank=rank}}</span>{{/if}}
  {{#if blessed}}<i class="fa-solid fa-sparkles" inert></i>{{/if}}
</button>
