<div class="sla-body">
  {{#unless ready}}
  <p class="sla-empty">{{notReady}}</p>
  {{else}}

  <header class="sla-head">
    {{#if date}}<span class="sla-date {{#if lookAhead.preview}}preview{{/if}}"><i class="fa-solid fa-calendar-day" inert></i> {{date}}</span>{{/if}}
    <div class="sla-lookahead">
      {{!-- The today button keeps its place left of the arrows, hidden at today, so the arrows never move --}}
      <button type="button" name="today" class="sla-today {{#unless lookAhead.preview}}inactive{{/unless}}"
              data-action="today" data-tooltip="SLA.LookAhead.TodayHint" {{#unless lookAhead.preview}}disabled{{/unless}}>
        <i class="fa-solid fa-rotate-left" inert></i> {{localize "SLA.LookAhead.Today"}}
      </button>
      <button type="button" name="dayBack" data-action="shiftDays" data-days="-1" data-tooltip="SLA.LookAhead.Back"
              aria-label="{{localize "SLA.LookAhead.Back"}}"><i class="fa-solid fa-chevron-left" inert></i></button>
      <input type="number" name="offsetDays" value="{{lookAhead.days}}" min="{{lookAhead.min}}" max="{{lookAhead.max}}"
             step="1" data-tooltip="SLA.LookAhead.Offset" aria-label="{{localize "SLA.LookAhead.Offset"}}">
      <button type="button" name="dayForward" data-action="shiftDays" data-days="1" data-tooltip="SLA.LookAhead.Forward"
              aria-label="{{localize "SLA.LookAhead.Forward"}}"><i class="fa-solid fa-chevron-right" inert></i></button>
    </div>
    {{#if isGM}}
    <button type="button" class="sla-icon-button" data-action="exportJournal" data-tooltip="SLA.Export.Button"
            aria-label="{{localize "SLA.Export.Button"}}"><i class="fa-solid fa-book" inert></i></button>
    {{/if}}
    {{#if canOpenCosmos}}
    <button type="button" class="sla-icon-button" data-action="openCosmos" data-tooltip="SLA.Almanac.Cosmos"
            aria-label="{{localize "SLA.Almanac.Cosmos"}}"><i class="fa-solid fa-moon-over-sun" inert></i></button>
    {{/if}}
  </header>
  {{#if lookAhead.preview}}<p class="sla-preview-note"><i class="fa-solid fa-eye" inert></i> {{lookAhead.note}}</p>{{/if}}

  {{#if weather}}
  <section class="sla-weather">
    <span class="sla-weather-label">{{localize "SLA.Weather.Title"}}</span>
    {{#each weather.events}}
    <span class="sla-weather-event" {{#if color}}style="--sla-weather-color: {{color}}"{{/if}} data-tooltip="{{kind}}">
      {{#if icon}}<img src="{{icon}}" alt="" onerror="this.remove()">{{/if}}{{label}}
    </span>
    {{else}}
    <span class="sla-weather-event">{{localize "SLA.Weather.Clear"}}</span>
    {{/each}}
    {{#if weather.wind}}
    <span class="sla-wind"><i class="fa-solid fa-arrow-right" style="transform: rotate({{weather.wind.angle}}deg)" inert></i> {{weather.wind.text}}</span>
    {{/if}}
    {{#if weather.forecast.length}}
    <ol class="sla-wind-forecast plain">
      <li class="sla-forecast-head" data-tooltip="SLA.Weather.ForecastHint">{{localize "SLA.Weather.Forecast"}}</li>
      {{#each weather.forecast}}
      <li data-tooltip="{{date}}"><span class="sla-when">{{when}}</span>
        <i class="fa-solid fa-arrow-right" style="transform: rotate({{angle}}deg)" inert></i> {{text}}</li>
      {{/each}}
    </ol>
    {{/if}}
  </section>
  {{/if}}

  <section class="sla-section">
    <h3>{{localize "SLA.Almanac.Moons"}}</h3>
    <ol class="sla-bodies plain">
      {{#each moons}}{{> "modules/sephrals-lunar-almanac/templates/body-row.hbs"}}{{/each}}
    </ol>
  </section>

  {{#if showTimeline}}
  <section class="sla-section sla-timeline-section">
    <h3>{{#if (eq timeline.days 1)}}{{localize "SLA.Almanac.TimelineOne"}}{{else}}{{localize "SLA.Almanac.Timeline" days=timeline.days}}{{/if}}</h3>
    {{> "modules/sephrals-lunar-almanac/templates/timeline.hbs" timeline}}
  </section>
  {{/if}}

  {{#if realms.length}}
  <section class="sla-section">
    <h3>{{localize "SLA.Almanac.Realms"}}</h3>
    <ol class="sla-bodies realms plain">
      {{#each realms}}{{> "modules/sephrals-lunar-almanac/templates/body-row.hbs"}}{{/each}}
    </ol>
  </section>
  {{/if}}

  {{#if showRealmTimeline}}
  <section class="sla-section sla-timeline-section">
    <h3>{{localize "SLA.Almanac.RealmTimeline" days=realmTimeline.days}}</h3>
    {{> "modules/sephrals-lunar-almanac/templates/timeline.hbs" realmTimeline}}
  </section>
  {{/if}}

  {{#if unbound.length}}
  <section class="sla-section">
    <h3>{{localize "SLA.Almanac.Unbound"}}</h3>
    {{#each unbound}}
    <div class="sla-unbound">
      <span class="sla-unbound-label">{{label}}</span>
      <div class="sla-heroes">{{#each heroes}}{{> "modules/sephrals-lunar-almanac/templates/hero-chip.hbs"}}{{/each}}</div>
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{/unless}}
</div>
